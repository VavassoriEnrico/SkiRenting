{
  "name": "skirenting",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors cyan,blue \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend"
  },
  "devDependencies": { "concurrently": "^9.2.0" }
}
